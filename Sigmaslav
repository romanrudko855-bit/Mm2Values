local TAGS = { ValueTag = true, StabTag = true, ClassTag = true }

local function isShown(obj)
    local o = obj
    while o and o ~= PlayerGui do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end

local function clean(t)
    t = string.gsub(t, "<[^>]+>", "")
    t = string.gsub(t, "’", "'")
    return string.lower((string.gsub(t, "^%s*(.-)%s*$", "%1")))
end

local function fmt(n) return string.format("%.2f", n) end

local function getCard(lbl)
    local c = lbl.Parent
    for _ = 1, 3 do
        if c and c.Parent and c:IsA("GuiObject") and c.Parent:IsA("GuiObject")
            and c.AbsoluteSize.Y < c.AbsoluteSize.X * 0.8 then
            c = c.Parent
        else
            break
        end
    end
    return c
end

-- есть ли в карточке плашка "Chroma" + сколько штук (x2, x3...)
local function scanCard(card)
    local chroma, qty = false, 1
    if not card then return chroma, qty end
    for _, c in ipairs(card:GetDescendants()) do
        if c:IsA("TextLabel") and not TAGS[c.Name] then
            local t = clean(c.Text)
            if t == "chroma" and isShown(c) then chroma = true end
            local q = string.match(t, "^x%s*(%d+)$")
                or string.match(t, "^×%s*(%d+)$")
                or string.match(t, "^(%d+)%s*x$")
            if q then qty = math.max(qty, tonumber(q)) end
        end
    end
    return chroma, qty
end

local function makeTag(card, name, y, h, ts, font)
    local tag = card:FindFirstChild(name)
    if not tag then
        tag = Instance.new("TextLabel")
        tag.Name = name
        tag.BackgroundTransparency = 1
        tag.Size = UDim2.new(1, 0, 0, h)
        tag.Position = UDim2.new(0, 0, 0, y)
        tag.Font = font or TEXT_FONT
        tag.TextSize = ts
        tag.TextColor3 = Color3.new(1, 1, 1)
        tag.TextStrokeTransparency = 0
        tag.ZIndex = 50
        tag.Parent = card
    end
    return tag
end

local function setRainbow(lbl, on)
    local g = lbl:FindFirstChild("Rainbow")
    if on and not g then
        g = Instance.new("UIGradient")
        g.Name = "Rainbow"
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 70, 70)),
            ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 200, 60)),
            ColorSequenceKeypoint.new(0.40, Color3.fromRGB(90, 255, 120)),
            ColorSequenceKeypoint.new(0.60, Color3.fromRGB(70, 210, 255)),
            ColorSequenceKeypoint.new(0.80, Color3.fromRGB(150, 110, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 90, 220)),
        })
        g.Parent = lbl
    elseif not on and g then
        g:Destroy()
    end
end

local function setBar(pct)
    local f = math.clamp(math.abs(pct) / 100, 0, 1) * 0.5
    if pct > 0 then
        tween(rightFill, { Size = UDim2.new(f, 0, 1, 0) })
        tween(leftFill,  { Size = UDim2.new(0, 0, 1, 0) })
    elseif pct < 0 then
        tween(leftFill,  { Size = UDim2.new(f, 0, 1, 0) })
        tween(rightFill, { Size = UDim2.new(0, 0, 1, 0) })
    else
        tween(leftFill,  { Size = UDim2.new(0, 0, 1, 0) })
        tween(rightFill, { Size = UDim2.new(0, 0, 1, 0) })
    end
end

local function update()
    local myHeader, theirHeader, tradeRoot
    for _, g in ipairs(PlayerGui:GetChildren()) do
        if g ~= gui and g:IsA("ScreenGui") and g.Enabled then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local u = string.upper(d.Text)
                    if string.find(u, "YOUR OFFER", 1, true) then myHeader, tradeRoot = d, g end
                    if string.find(u, "THEIR OFFER", 1, true) then theirHeader = d end
                end
            end
            if myHeader and theirHeader then break end
        end
    end

    if not (myHeader and theirHeader) then
        tradeOpen = false
        refreshVisibility()
        return
    end
    tradeOpen = true
    refreshVisibility()

    local myY, theirY = myHeader.AbsolutePosition.Y, theirHeader.AbsolutePosition.Y
    local minX = math.min(myHeader.AbsolutePosition.X, theirHeader.AbsolutePosition.X) - 5
    local myTotal, theirTotal, unknown = 0, 0, 0

    for _, d in ipairs(tradeRoot:GetDescendants()) do
        if d:IsA("TextLabel") and not TAGS[d.Name] and d.Text ~= "" and isShown(d) then
            local baseKey = clean(d.Text)
            local pos = d.AbsolutePosition
            if baseKey ~= "chroma" and VALUES[baseKey] ~= nil or string.sub(baseKey, 1, 7) == "chroma " then
                if pos.X >= minX and pos.Y > myY then
                    local card = getCard(d)
                    local isChroma, qty = scanCard(card)

                    local key = baseKey
                    if isChroma and string.sub(baseKey, 1, 7) ~= "chroma " then
                        key = "chroma " .. baseKey
                    end
                    local v = VALUES[key]
                    if v == nil then v = 0 end
                    isChroma = isChroma or string.sub(key, 1, 7) == "chroma "

                    local sum = v * qty
                    if v == 0 then unknown += 1 end
                    if pos.Y >= theirY then theirTotal += sum else myTotal += sum end

                    if card and card:IsA("GuiObject") then
                        local vt = makeTag(card, "ValueTag", 2, 16, 14, NUM_FONT)
                        local ct = makeTag(card, "ClassTag", 18, 12, 10)
                        local sg = makeTag(card, "StabTag", 30, 12, 10)

                        local cls = "Godly"
                        if isChroma then cls = "Chroma"
                        elseif ANCIENT[key] then cls = "Ancient"
                        elseif LEGENDARY[key] then cls = "Legendary"
                        elseif key == "corrupt" then cls = "Unique" end
                        ct.Text = cls
                        ct.TextColor3 = CLASS_COLORS[cls] or Color3.new(1, 1, 1)
                        setRainbow(ct, isChroma)

                        if v == 0 then
                            vt.Text = "?"
                            sg.Text = "unknown"
                            sg.TextColor3 = Color3.fromRGB(190, 190, 190)
                        else
                            vt.Text = (qty > 1) and (fmt(sum) .. " (x" .. qty .. ")") or fmt(sum)
                            local s = STABILITY[key] or "Stable"
                            sg.Text = s
                            sg.TextColor3 = STAB_COLORS[s] or Color3.new(1, 1, 1)
                        end
                    end
                end
            end
        end
    end

    local diff = theirTotal - myTotal
    local pct = 0
    if myTotal > 0 then
        pct = diff / myTotal * 100
    elseif theirTotal > 0 then
        pct = 100
    end

    myL.Text, theirL.Text = fmt(myTotal), fmt(theirTotal)
    diffL.Text = (diff > 0 and "+" or "") .. fmt(diff)

    if diff > 0 then
        result.Text = "WIN"
        result.TextColor3 = GREEN
        diffL.TextColor3 = GREEN
    elseif diff < 0 then
        result.Text = "LOSE"
        result.TextColor3 = RED
        diffL.TextColor3 = RED
    else
        result.Text = "FAIR"
        result.TextColor3 = white
        diffL.TextColor3 = white
    end
    setBar(diff == 0 and 0 or pct)
    titleL.Text = unknown > 0 and (TITLE .. "  (unknown: " .. unknown .. ")") or TITLE
end

task.spawn(function()
    while gui.Parent do
        pcall(update)
        task.wait(0.4)
    end
end)
